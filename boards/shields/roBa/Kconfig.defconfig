if SHIELD_ROBA_R

config ZMK_KEYBOARD_NAME
    default "roBa"

config ZMK_BLE
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Right side has the IQS7211E trackpad.
config ZMK_POINTING
    default y

config IQS7211E
    default y

endif # SHIELD_ROBA_R


if SHIELD_ROBA_L

# Keep pointing enabled on the left side as well because the shared keymap
# contains mouse behaviors. No pointing device is defined on the left overlay.
config ZMK_POINTING
    default y

endif # SHIELD_ROBA_L


if SHIELD_ROBA_R || SHIELD_ROBA_L

config NFCT_PINS_AS_GPIOS
    default y

config ZMK_SPLIT
    default y

config INPUT
    default y

# RGB LED widget settings
config RGBLED_WIDGET_BATTERY_LEVEL_HIGH
    default 30

config RGBLED_WIDGET_BATTERY_LEVEL_CRITICAL
    default 10

endif # SHIELD_ROBA_R || SHIELD_ROBA_L
