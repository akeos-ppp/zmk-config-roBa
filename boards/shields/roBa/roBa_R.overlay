/ {
    roba_xy_transform: input_processor_transform {
        compatible = "zmk,input-processor-transform";
        #input-processor-cells = <1>;
        type = <INPUT_EV_REL>;
    };

    roba_xy_to_scroll: xy_to_scroll_mapper {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map = <INPUT_REL_X INPUT_REL_HWHEEL>,
              <INPUT_REL_Y INPUT_REL_WHEEL>;
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball>;
        
        // 通常モード（X軸・Y軸反転）
        input-processors = <&roba_xy_transform INPUT_TRANSFORM_X_INVERT>,
                          <&roba_xy_transform INPUT_TRANSFORM_Y_INVERT>;
        
        // レイヤー2でスクロールモード
        scroller {
            layers = <5>;
            input-processors = <&roba_xy_to_scroll>;
        };
    };
};
