#include "roBa.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* --- right half column offset --- */
&default_transform {
    col-offset = <6>;
};

/* --- keyscan columns --- */
&kscan0 {
    col-gpios = <&xiao_d 10 GPIO_ACTIVE_HIGH>,
                <&xiao_d  9 GPIO_ACTIVE_HIGH>,
                <&xiao_d  8 GPIO_ACTIVE_HIGH>,
                <&xiao_d  7 GPIO_ACTIVE_HIGH>,
                <&gpio0  10 GPIO_ACTIVE_HIGH>;
};

/* --- SPI pin configuration for PAW3222 --- */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;  /* MISO は実配線に合わせて必要なら変更 */
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

/* UART は使わないので無効化 */
&xiao_serial {
    status = "disabled";
};

/* --- SPI0 + trackball sensor node --- */
&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    /* CS pin for PAW3222 */
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball_central: trackball_central@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;

        /* MOTION ピン: P0.02 → IRQ 割り込み */
        irq-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
    };
};

/* --- Trackball listener: Auto Mouse Layer + scroll --- */
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    /* Auto Mouse Layer (AML)
     *  - 4 = MOUSE レイヤー
     *  - 8000ms = 最後の入力から 8 秒間維持
     */
    input-processors = <&zip_temp_layer 4 8000>;

    /* 通常ポインタモード（カーソル移動） */
    pointer {
        /* ポインタを効かせたいレイヤー
         * 0: デフォルト, 4: MOUSE, 5: SCROLL, 6: NUM
         * （多めに入れておいても問題なし）
         */
        layers = <0 4 5 6>;

        /* いまの動きが「自然」になっている前提で X/Y 反転を維持 */
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
                           <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>;
    };

    /* スクロールモード（SCROLL レイヤー = 5） */
    scroller {
        layers = <5>;

        input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>, /* 必要に応じてX/Y入れ替え */
                           <&zip_xy_to_scroll_mapper>,                  /* 移動 → スクロールに変換 */
                           <&zip_scroll_scaler 1 5>;                    /* スクロール量を 1/5 に */
    };
};
