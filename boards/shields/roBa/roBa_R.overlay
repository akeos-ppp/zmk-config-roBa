#include "roBa.dtsi"
#include <dt-bindings/zmk/input_transform.h>

/* --- 右手側の列オフセット --- */
&default_transform {
    col-offset = <6>;
};

/* --- 右手側の keyscan カラム定義 --- */
&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d  9 GPIO_ACTIVE_HIGH>
        , <&xiao_d  8 GPIO_ACTIVE_HIGH>
        , <&xiao_d  7 GPIO_ACTIVE_HIGH>
        , <&gpio0  10 GPIO_ACTIVE_HIGH>
        ;
};

/* --- I2C0 ピン設定（IQS7211E 用）
 *
 * 元の配線:
 *  - P0.05: SPI SCK   → ここでは I2C SCL
 *  - P0.04: SPI MOSI  → ここでは I2C SDA
 *  - P0.02: MOTION    → ここでは RDY (IRQ)
 *  - P0.09: CS        → 必要なら電源制御に流用
 */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SCL, 0, 5)>,  /* SCL: P0.05 */
                <NRF_PSEL(TWIM_SDA, 0, 4)>;  /* SDA: P0.04 */
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SCL, 0, 5)>,
                <NRF_PSEL(TWIM_SDA, 0, 4)>;
            bias-pull-up;
            low-power-enable;
        };
    };
};

/* UART は使わないので無効化（元と同じ） */
&xiao_serial {
    status = "disabled";
};

/* --- I2C0 + IQS7211E トラックパッド本体 --- */
&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    /* 400kHz I2C (標準的な設定) */
    clock-frequency = <I2C_BITRATE_FAST>;
    zephyr,concat-buf-size = <32>;

    trackpad: trackpad@56 {
        status = "okay";
        compatible = "azoteq,iqs7211e";
        reg = <0x56>;  /* IQS7211E 固定アドレス */

        /* RDY: 元 MOTION の P0.02 を流用
         *  open-drain active-low なので、LOW + PULL_UP
         */
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        /* もし VCC を P0.09 で ON/OFF しているなら、以下を有効にする
         *  元の CS(P0.09) を電源制御に流用している場合を想定
         */
        // power-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
    };
};
