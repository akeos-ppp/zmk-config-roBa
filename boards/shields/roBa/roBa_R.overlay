#include "roBa.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* レイヤー番号のマクロ（MOUSEレイヤー） */
#define MOUSE 4

/* --- 右手側の列オフセット --- */
&default_transform {
    col-offset = <6>;
};

/* --- 右手側の keyscan カラム定義 --- */
&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d  9 GPIO_ACTIVE_HIGH>
        , <&xiao_d  8 GPIO_ACTIVE_HIGH>
        , <&xiao_d  7 GPIO_ACTIVE_HIGH>
        , <&gpio0  10 GPIO_ACTIVE_HIGH>
        ;
};

/* --- SPI ピン設定（PAW3222 用） --- */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels =
                <NRF_PSEL(SPIM_SCK,  0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels =
                <NRF_PSEL(SPIM_SCK,  0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

/* UART は使わないので無効化 */
&xiao_serial {
    status = "disabled";
};

/* --- SPI0 + PAW3222 センサ本体 --- */
&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    /* CS ピン (P0.09) */
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball_central: trackball_central@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;

        /* MOTION ピン: P0.02 → IRQ 割り込み */
        irq-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
    };
};

/* --- zip_temp_layer の設定（AML解除条件など） --- */
&zip_temp_layer {
    /* AMLを解除したいキー位置（レイヤー0のposition番号）をまとめて<>で指定 */
    excluded-positions = <7 16 18 19 20 22 30 31 33>;
    require-prior-idle-ms = <200>;
};

/* --- Input Processor 定義 + トラックボール Listener --- */
 / {
    /* ここで input_processors ノードを拡張（または新規作成） */
    input_processors {
        /* 水平スクロール用スケーラー（X方向） */
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };

        /* 垂直スクロール用スケーラー（Y方向） */
        zip_scroll_y_scaler: zip_scroll_y_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };

    /* --- トラックボール Listener (AML + スクロール) --- */
    trackball_central_listener: trackball_central_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball_central>;

        /*
         * 1) トラックボールが動いたら MOUSE レイヤー (4) を 1000ms オン
         * 2) その入力に XY 反転をかけて、取り付け向きに合わせる
         */
        input-processors = <
            &zip_temp_layer MOUSE 1000
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        >;

        /* ===== レイヤー 5: 縦スクロール専用（上下のみ） ===== */
        scroller_vertical {
            layers = <5>;
            input-processors = <
                &zip_xy_to_scroll_mapper
                &zip_scroll_x_scaler 0 1   /* X = 0倍 → 横スクロール殺す */
                &zip_scroll_scaler 1 10    /* 全体 1/10 でフニャ軽減 */
            >;
        };

        /* ===== レイヤー 3: 横スクロール専用（左右のみ） ===== */
        scroller_horizontal {
            layers = <3>;
            input-processors = <
                &zip_xy_to_scroll_mapper
                &zip_scroll_y_scaler 0 1   /* Y = 0倍 → 縦スクロール殺す */
                &zip_scroll_scaler 1 10    /* 少しだけ動く横スクロール */
            >;
        };
    };
};
