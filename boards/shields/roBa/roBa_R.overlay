#include "roBa.dtsi"
#include <dt-bindings/zmk/input_transform.h>

/* --- 右手側の列オフセット --- */
&default_transform {
    col-offset = <6>;
};

/* --- 右手側の keyscan カラム定義 --- */
&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d  9 GPIO_ACTIVE_HIGH>
        , <&xiao_d  8 GPIO_ACTIVE_HIGH>
        , <&xiao_d  7 GPIO_ACTIVE_HIGH>
        , <&gpio0  10 GPIO_ACTIVE_HIGH>
        ;
};

/* --- I2C ピン設定（IQS7211E 用） --- */
/* ★ SCL/SDA の P0.xx は実際の配線に合わせて変更する */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels =
                <NRF_PSEL(TWIM_SDA, 0, 17)>,
                <NRF_PSEL(TWIM_SCL, 0, 20)>;
            bias-pull-up;
            low-power-enable;
        };
    };
};

/* UART は使わないので無効化 */
&xiao_serial {
    status = "disabled";
};

/* --- I2C0 + IQS7211E トラックパッド本体 --- */
/* ★ irq-gpios の P0.xx も RDY の実配線に合わせて変更する */
&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;
    zephyr,concat-buf-size = <32>;

    trackpad: trackpad@56 {
        status = "okay";
        compatible = "azoteq,iqs7211e";
        reg = <0x56>;

        /* RDY ピン (アクティブロー, プルアップ) */
        irq-gpios = <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        /* 電源を GPIO で制御している場合だけ有効化
         * 3.3V 直結なら power-gpios 行は削除してよい
         */
        // power-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
    };
};
