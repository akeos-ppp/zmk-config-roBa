#include "roBa.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* --- Input Processor 定義（水平スクロールだけをいじる） --- */
 / {
    input_processors {
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;  /* 水平スクロールだけ拾う */
            track-remainders;
        };
    };
};

/* --- 右手側の列オフセット --- */
&default_transform {
    col-offset = <6>;
};

/* --- 右手側の keyscan カラム定義 --- */
&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d  9 GPIO_ACTIVE_HIGH>
        , <&xiao_d  8 GPIO_ACTIVE_HIGH>
        , <&xiao_d  7 GPIO_ACTIVE_HIGH>
        , <&gpio0  10 GPIO_ACTIVE_HIGH>
        ;
};

/* --- SPI ピン設定（PAW3222 用） --- */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels =
                <NRF_PSEL(SPIM_SCK,  0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels =
                <NRF_PSEL(SPIM_SCK,  0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

/* UART は使わないので無効化 */
&xiao_serial {
    status = "disabled";
};

/* --- SPI0 + PAW3222 センサ本体 --- */
&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    /* CS ピン (P0.09) */
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball_central: trackball_central@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;

        /* MOTION ピン: P0.02 → IRQ 割り込み */
        irq-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
    };
};

/* --- トラックボール Listener (AML + スクロール) --- */
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;

    /*
     * 1) トラックボールが動いたら MOUSE レイヤー (4) を 1000ms オン
     * 2) その入力に XY 反転をかけて、取り付け向きに合わせる
     */
    input-processors = <
        &zip_temp_layer 4 1000
        &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
    >;

    /* SCROLL レイヤー (5) のときだけスクロールモード */
    scroller {
        layers = <5>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_x_scaler 0 1
            &zip_scroll_scaler 1 10
        >;
    };
};
